---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags" role="list">
    {tags.map((tag) => (
      <li class="tag">{tag}</li>
    ))}
  </ul>
)}

<style>
  .tags {
    display: flex;
    /* タグ数はCMSで自由に増えるため、1行に収まらなければ折り返す（カード幅からはみ出して切れるのを防ぐ） */
    flex-wrap: wrap;
    list-style: none;
    gap: 0.5rem;
  }
  .tag {
    font-size: 0.85rem;
    padding: 0.1rem 0.5rem;
    background: var(--color-tag-bg);
    border-radius: 2px;
  }
</style>
