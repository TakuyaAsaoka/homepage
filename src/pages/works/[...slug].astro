---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagList from "../../components/TagList.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { render } from "astro:content";
import { BASE_PATH, SITE_LOCALE } from "../../consts";
import { getPublishedWorks } from "../../works";
import { formatPubDate } from "../../date";

export async function getStaticPaths() {
  const works = await getPublishedWorks();
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content, headings } = await render(work);

const pubDateLabel = formatPubDate(work.data.pubDate, SITE_LOCALE);
---

<BaseLayout
  title={work.data.title}
  description={work.data.description}
  image={work.data.image?.src}
  breadcrumb={[
    { label: "Works", href: `${BASE_PATH}works/` },
    { label: work.data.title },
  ]}
  article={{
    datePublished: work.data.pubDate,
    keywords: work.data.tags,
    image: work.data.image?.src,
  }}
>
  <article>
    <h1>{work.data.title}</h1>
    {/* 詳細ページは実際の画像があるときだけ出す（デフォルト画像は制作の内容を表さないため）。
        Image は寸法を属性に出すため、読み込み前から高さが確保され本文が押し出されない。
        ページ最上部に出る画像なので、既定の遅延読み込み（loading="lazy"）は打ち消す。
        表示幅はコンテンツ幅いっぱい（最大736px）。widths は等倍と2倍の画面をまかなう */}
    {work.data.image && (
      <Image
        class="hero-image"
        src={work.data.image}
        alt={work.data.title}
        widths={[736, 1472]}
        sizes="(min-width: 800px) 736px, 100vw"
        loading="eager"
        decoding="async"
      />
    )}
    <time datetime={work.data.pubDate}>{pubDateLabel}</time>
    <TagList tags={work.data.tags} />
    {work.data.url && (
      <p><a href={work.data.url} target="_blank" rel="noopener noreferrer">制作を見る</a></p>
    )}
    <TableOfContents headings={headings} />
    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  time {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  /* コンテナ幅に収めるのはグローバルの img { max-width: 100% } が担う。
     小さい画像を引き伸ばさないよう width は指定しない */
  .hero-image {
    display: block;
    margin-block: 1rem 0.75rem;
    border-radius: 4px;
  }
  article :global(.tags) {
    margin: 0.5rem 0;
  }
  .content {
    margin-top: 2rem;
  }
  /* Markdown本文の縦リズム（グローバルリセットで消えた余白を戻す） */
  .content :global(p) {
    margin-block: 1em;
  }
  .content :global(ul),
  .content :global(ol) {
    margin-block: 1em;
    padding-left: 1.5em;
  }
  .content :global(li) {
    margin-block: 0.4em;
  }
  .content :global(h2),
  .content :global(h3) {
    margin-block: 1.5em 0.75em;
  }
</style>
