---
import TagList from "./TagList.astro";
import { BASE_PATH } from "../consts";

interface Props {
  title: string;
  description: string;
  tags: string[];
  slug: string;
}

const { title, description, tags, slug } = Astro.props;
---

<article class="work-card">
  <h3>
    <a href={`${BASE_PATH}works/${slug}/`}>{title}</a>
  </h3>
  <p>{description}</p>
  <TagList tags={tags} />
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .work-card h3 a {
    text-decoration: none;
    color: inherit;
  }
  .work-card h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--season-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  /* カード高さが行内で揃った際、タグを下端に寄せて空白の浮きを防ぐ */
  .work-card :global(.tags) {
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
