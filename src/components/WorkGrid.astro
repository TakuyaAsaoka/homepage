---
import type { CollectionEntry } from "astro:content";
import WorkCard from "./WorkCard.astro";

interface Props {
  works: CollectionEntry<"works">[];
}

const { works } = Astro.props;
---

<ul class="work-grid" role="list">
  {works.map((work) => (
    <li data-reveal="delayed">
      <WorkCard
        title={work.data.title}
        description={work.data.description}
        tags={work.data.tags}
        slug={work.id}
        pubDate={work.data.pubDate}
        image={work.data.image}
        role={work.data.role}
        outcome={work.data.outcome}
      />
    </li>
  ))}
</ul>

<style>
  /* デスクトップは2カラム、モバイルは1カラム。
     実効コンテンツ幅（約736px）では3カラム以上が成立しないため、
     auto-fit ではなく固定2カラム＋メディアクエリで折返し点を明示する。 */
  .work-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding: 0;
  }
  /* li を grid にして内側の article を行の高さまで stretch させ、カード高さを揃える */
  .work-grid li {
    display: grid;
  }
  @media (max-width: 767px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
