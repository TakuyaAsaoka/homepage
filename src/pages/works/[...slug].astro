---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import TagList from "../../components/TagList.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { render } from "astro:content";
import { BASE_PATH, SITE_LOCALE } from "../../consts";
import { getPublishedWorks } from "../../works";
import { formatPubDate } from "../../date";

export async function getStaticPaths() {
  const works = await getPublishedWorks();
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content, headings } = await render(work);

const pubDateLabel = formatPubDate(work.data.pubDate, SITE_LOCALE);
---

<BaseLayout
  title={work.data.title}
  description={work.data.description}
  image={work.data.image?.src}
  breadcrumb={[
    { label: "Works", href: `${BASE_PATH}works/` },
    { label: work.data.title },
  ]}
  article={{
    datePublished: work.data.pubDate,
    keywords: work.data.tags,
    image: work.data.image?.src,
  }}
>

    <Section level={1} title={work.data.title}>
      {/* 左の細い列に日付・タグ・目次、右の列に画像と本文を置く */}
      <div class="detail">
        {/* 登場の動きは左の列だけに付ける。右の列に付けると、ページ最上部の画像が出るのが遅れる */}
        <div data-reveal="delayed">
          <time datetime={work.data.pubDate}>{pubDateLabel}</time>
          <TagList tags={work.data.tags} />
          {work.data.url && (
            <p><a href={work.data.url} target="_blank" rel="noopener noreferrer">制作を見る</a></p>
          )}
          <TableOfContents headings={headings} />
        </div>
        <div>
          {/* 詳細ページは実際の画像があるときだけ出す（デフォルト画像は制作の内容を表さないため）。
              Image は寸法を属性に出すため、読み込み前から高さが確保され本文が押し出されない。
              ページ最上部に出る画像なので、既定の遅延読み込み（loading="lazy"）は打ち消す。
              表示幅は右の列いっぱい（最大708px）、959px以下の1列のときはほぼ画面幅。
              元の画像が 1416px より小さいときは、元の幅までしか出ない */}
          {work.data.image && (
            <Image
              class="hero-image"
              src={work.data.image}
              alt={work.data.title}
              widths={[708, 1416]}
              sizes="(min-width: 1080px) 708px, (min-width: 960px) calc(100vw - 372px), 100vw"
              loading="eager"
              decoding="async"
            />
          )}
          <div class="content">
            <Content />
          </div>
        </div>
      </div>
    </Section>

</BaseLayout>

<style>
  /* 右の列の幅（全体の幅 − 左の列 − 列の間）が、本文の1行の長さの上限になる。狭い画面では1列 */
  .detail {
    display: grid;
    /* minmax(0, …) は、長い語やURLが列を押し広げないようにするため */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem var(--col-gap);
    align-items: start;
  }
  /* 左の列は幅を固定しているので、本文の列が狭くなりすぎない幅から2列にする */
  @media (min-width: 960px) {
    .detail {
      grid-template-columns: 260px minmax(0, 1fr);
    }
  }
  time {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
  /* コンテナ幅に収めるのはグローバルの img { max-width: 100% } が担う。
     小さい画像を引き伸ばさないよう width は指定しない */
  .hero-image {
    display: block;
    margin-bottom: 2rem;
    border-radius: 4px;
  }
  .detail :global(.tags) {
    margin: 0.5rem 0;
  }
  /* 本文の最初の段落の上の余白を消し、左の列と上端をそろえる */
  .content > :global(:first-child) {
    margin-top: 0;
  }
  /* Markdown本文の縦リズム（グローバルリセットで消えた余白を戻す） */
  .content :global(p) {
    margin-block: 1em;
  }
  .content :global(ul),
  .content :global(ol) {
    margin-block: 1em;
    padding-left: 1.5em;
  }
  .content :global(li) {
    margin-block: 0.4em;
  }
  .content :global(h2),
  .content :global(h3) {
    margin-block: 1.5em 0.75em;
  }
</style>
