---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkGrid from "../components/WorkGrid.astro";
import { BASE_PATH, REPOSITORY_URL } from "../consts";
import { toParagraphs } from "../paragraphs";
import { getSiteSettings } from "../site-settings";
import { getPublishedWorks } from "../works";

// CMS管理のHome文言とサイト設定を取得する
const homeEntry = await getEntry("home", "home");
if (!homeEntry) {
  throw new Error("Home文言（src/content/pages/home.yaml）が見つかりません");
}
const home = homeEntry.data;
const site = await getSiteSettings();

// 自己紹介に出す経歴は、Aboutの文言から読む（同じ文章を home.yaml に写さない）。
// Aboutのセクションは CMS で並び替え・改名できるため、順番ではなく英字ラベルで探す。
// 見つからないときは黙って空にせず、ビルドを落として気づけるようにする
const CAREER_LABEL = "CAREER";
const aboutEntry = await getEntry("about", "about");
const career = aboutEntry?.data.sections.find((section) => section.label === CAREER_LABEL);
if (!career) {
  throw new Error(
    `Aboutの文言（src/content/pages/about.yaml）に、英字ラベルが ${CAREER_LABEL} のセクションが見つかりません`,
  );
}

// 見出しはCMSで改行した位置で行を分ける
const headingLines = home.hero.heading.split("\n").filter((line) => line.trim() !== "");

// GitHubリンクの表示テキストはURLから導出する（URLだけ変更されて表示が古く残ることを防ぐ）
const githubLabel = site.social.github.replace(/^https?:\/\//, "");
// ヒーローの窓の帯に出す、このサイトのリポジトリの住所（同じ理由でURLから導出する）
const repositoryLabel = REPOSITORY_URL.replace(/^https?:\/\//, "");

// 制作セクションに抜粋する最新の制作（draft除外・pubDate降順の先頭2件）
const recentWorks = (await getPublishedWorks()).slice(0, 2);
---

<BaseLayout title="Home" description={site.description}>
  {/* ヒーローの窓だけが使う等幅の書体。全ページが読む fonts.css には入れず、Home だけで読む */}
  <link slot="head" rel="stylesheet" href={`${BASE_PATH}fonts-mono.css`} />

  {/* エディタの窓を模したヒーロー。行番号・記号（# と >）・項目名（role: と work:）・閉じる印・入力待ちの印は飾りなので、
      読み上げからは隠す。読み上げには、見出し・肩書き・仕事の説明・2つのリンクだけが残る */}
  <div slot="hero" class="hero">
    <div class="hero-blobs" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <div class="hero-window">
      <div class="hero-bar">
        <a href={REPOSITORY_URL} target="_blank" rel="noopener noreferrer">{repositoryLabel}</a>
        <span aria-hidden="true">×</span>
      </div>
      <div class="hero-code">
        <h1 class="hero-heading">
          {headingLines.map((line, index) => (
            <span class="code-line">
              <span class="line-no" aria-hidden="true">{index + 1}</span>
              <span class={index === 0 ? undefined : "heading-rest"}>
                {index === 0 && <span class="code-mark" aria-hidden="true">{"# "}</span>}
                {line}
              </span>
            </span>
          ))}
        </h1>
        <div class="hero-meta">
          <p class="code-line">
            <span class="line-no" aria-hidden="true">{headingLines.length + 1}</span>
            <span class="code-pair"><span class="code-key" aria-hidden="true">role:</span><span>{home.hero.role}</span></span>
          </p>
          <p class="code-line">
            <span class="line-no" aria-hidden="true">{headingLines.length + 2}</span>
            <span class="code-pair"><span class="code-key" aria-hidden="true">work:</span><span>{home.hero.lead}</span></span>
          </p>
        </div>
        <ul class="hero-links" role="list">
          <li class="code-line">
            <span class="line-no" aria-hidden="true">{headingLines.length + 3}</span>
            {/* span で包む。包まないと a が行いっぱいに伸び、押せる範囲とフォーカスの枠が広がる */}
            <span>
              <a class="hero-link" href="#works">
                <span class="code-mark" aria-hidden="true">&gt;</span>制作を見る
              </a>
            </span>
          </li>
          <li class="code-line">
            <span class="line-no" aria-hidden="true">{headingLines.length + 4}</span>
            <span>
              <a class="hero-link" href="#contact">
                <span class="code-mark" aria-hidden="true">&gt;</span>連絡する
              </a>
              <span class="caret" aria-hidden="true"></span>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <section class="home-section" id="about">
    <h2 class="section-heading" data-reveal>
      <span class="section-title">自己紹介</span>
      <span class="section-label" aria-hidden="true">ABOUT</span>
    </h2>
    <div class="profile" data-reveal="delayed">
      {home.profile.photo && (
        <Image
          class="profile-photo"
          src={home.profile.photo}
          alt={`${site.author}の写真`}
          widths={[200, 400, 600]}
          sizes="200px"
        />
      )}
      <div class="profile-body">
        <p class="profile-name">{site.author}</p>
        <p class="profile-role">{home.hero.role}</p>
        {toParagraphs(career.body).map((paragraph) => <p class="profile-text">{paragraph}</p>)}
        <dl class="profile-table">
          <div>
            <dt>活動場所</dt>
            <dd>{home.profile.place}</dd>
          </div>
          <div>
            <dt>連絡先</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          {site.social.github && (
            <div>
              <dt>GitHub</dt>
              <dd>
                <a href={site.social.github} target="_blank" rel="noopener noreferrer">{githubLabel}</a>
              </dd>
            </div>
          )}
        </dl>
        <a class="section-more" href={`${BASE_PATH}about/`}>
          {home.profile.linkLabel}<span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-section">
    <h2 class="section-heading" data-reveal>
      <span class="section-title">できること</span>
      <span class="section-label" aria-hidden="true">WHAT I DO</span>
    </h2>
    <ul class="service-list" role="list" data-reveal="delayed">
      {home.services.map((service) => (
        <li>
          <h3>{service.title}</h3>
          <p>{service.body}</p>
          {service.tools.length > 0 && <p class="service-tools">{service.tools.join("・")}</p>}
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section" id="works">
    <h2 class="section-heading" data-reveal>
      <span class="section-title">制作</span>
      <span class="section-label" aria-hidden="true">WORKS</span>
    </h2>
    {recentWorks.length > 0 ? (
      <WorkGrid works={recentWorks} />
    ) : (
      <p class="works-empty" data-reveal="delayed">公開できる制作を準備中です。</p>
    )}
    <a class="section-more" href={`${BASE_PATH}works/`} data-reveal="delayed">
      制作をすべて見る<span class="arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section class="home-section" id="contact">
    <h2 class="section-heading" data-reveal>
      <span class="section-title">連絡先</span>
      <span class="section-label" aria-hidden="true">CONTACT</span>
    </h2>
    <div data-reveal="delayed">
      <p class="contact-invite">{home.contact.invite}</p>
      <a class="contact-button" href={`mailto:${site.email}`}>
        {site.email}<span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== ヒーロー（エディタの窓） ===== */
  /* 窓を横の中央・縦の中央に置く。高さは決めず、上下の余白で最初の画面に収める
     （幅1280×高さ720の画面で、ヘッダーと合わせて窓の全体が見える余白にしている） */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 10vh, 5.5rem) var(--content-pad);
    /* ぼかした色がヒーローの外（ヘッダーや次の区切り）へにじみ出ないように切る */
    overflow: clip;
  }

  /* にじむ色。差し色をぼかしたかたまりを4つ置く。位置と大きさは割合で持ち、画面の幅に追従する。
     上下の端は薄くして消す。切ったままだと、ヒーローの上下でぼかしが直線で途切れて見える */
  .hero-blobs {
    position: absolute;
    inset: 0;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 78%, transparent);
  }
  .hero-blobs span {
    position: absolute;
    border-radius: 50%;
    background: var(--accent);
    filter: blur(48px);
  }
  .hero-blobs span:nth-child(1) {
    top: 6%;
    right: 7%;
    width: 26%;
    height: 46%;
    opacity: 0.34;
  }
  .hero-blobs span:nth-child(2) {
    top: 38%;
    right: 23%;
    width: 20%;
    height: 34%;
    opacity: 0.2;
  }
  .hero-blobs span:nth-child(3) {
    bottom: 3%;
    left: 5%;
    width: 28%;
    height: 40%;
    opacity: 0.26;
  }
  .hero-blobs span:nth-child(4) {
    top: 9%;
    left: 17%;
    width: 16%;
    height: 24%;
    opacity: 0.16;
  }

  /* 窓。地を少し透かして、後ろのにじむ色をうっすら通す */
  .hero-window {
    position: relative;
    width: min(100%, 680px);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    /* color-mix() を知らないブラウザでは次の行が無視されるので、透かさない地を先に置く */
    background: var(--color-bg);
    background: color-mix(in srgb, var(--color-bg) 84%, transparent);
    box-shadow: 0 18px 40px color-mix(in srgb, var(--color-text) 10%, transparent);
    font-family: var(--font-mono);
  }
  .hero-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 36px;
    padding-inline: 0.875rem;
    border-bottom: 1px solid var(--color-border);
    /* 狭い画面では字を小さくして、住所と外へ出る印（↗）を1行に収める */
    font-size: clamp(0.68rem, 3vw, 0.78rem);
    color: var(--color-muted);
  }
  /* 帯のリンクは窓の題として読ませるため、共通の下線は外す（hover のときだけ出す）。
     折り返すと帯が2行になるので折り返さず、それでも入らない幅では末尾を省く */
  .hero-bar a {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: inherit;
    text-decoration: none;
  }
  .hero-bar a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .hero-code {
    padding: 1.6rem 1.75rem 1.9rem 0.875rem;
  }

  /* 1行 = 行番号 + 中身。長い行は、行番号を増やさずに中身の側で折り返す（エディタの折り返しと同じ） */
  .code-line {
    display: grid;
    /* 行番号の列は rem で持つ。em にすると、字の大きい見出しの行だけ列が広がって頭がずれる */
    grid-template-columns: 1.9rem minmax(0, 1fr);
    column-gap: 0.875rem;
    align-items: baseline;
  }
  .line-no {
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-muted);
    text-align: right;
    user-select: none;
  }
  .hero-heading {
    /* 下限は、幅320pxの画面でも一番長い行が折り返さない大きさ */
    font-size: clamp(1rem, 5.2vw, 2rem);
    line-height: 1.5;
    letter-spacing: 0.02em;
  }
  /* 2行目以降は、1行目の「# 」の幅だけ下げて頭をそろえる */
  .heading-rest {
    padding-left: 2ch;
  }
  .code-mark,
  .code-key {
    color: var(--accent-text);
  }
  /* 「項目名: 値」の行。値が折り返したとき、2行目を項目名の下ではなく値の頭にそろえる */
  .code-pair {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.6em;
  }
  .hero-meta {
    margin-top: 1.1rem;
    font-size: 0.92rem;
    color: var(--color-text-soft);
  }
  .hero-links {
    list-style: none;
    margin-top: 0.9rem;
  }
  /* 高さ44pxは指で押せる大きさ。リンク共通の下線は外す */
  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  .hero-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  /* 入力待ちの印。1.1秒の周期で点いたり消えたりする（途中の濃さは作らない） */
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.3rem;
    background: var(--accent-text);
    vertical-align: text-bottom;
    animation: caret-blink 1.1s steps(1) infinite;
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  /* ===== ヒーロー入場アニメーション（純CSS・JS無効でも再生） ===== */
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero-window {
    opacity: 0;
    animation: hero-fade-up var(--anim-duration) var(--anim-ease) 0.1s forwards;
  }

  /* reduced-motion: 入場と点滅を止め、最終状態で静止 */
  @media (prefers-reduced-motion: reduce) {
    .hero-window {
      opacity: 1;
      animation: none;
    }
    .caret {
      animation: none;
    }
  }

  /* ===== セクション間隔 ===== */
  .home-section {
    margin-block: 5rem;
  }
  /* ヒーロー直後だけ詰める。main-inner の padding-top 1rem と合わせ、
     ヒーロー下端から 3.5rem の間隔にする */
  .home-section:first-of-type {
    margin-top: 2.5rem;
  }

  /* ===== 自己紹介 ===== */
  .profile {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2.5rem;
  }
  .profile-photo {
    width: 200px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
  }
  /* 写真の横に置けるだけの幅が無いとき（スマホ）は、写真の下へ折り返す */
  .profile-body {
    flex: 1 1 20rem;
    min-width: 0;
  }
  .profile-name {
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.12em;
  }
  .profile-role {
    margin-block: 0.4rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--color-muted);
  }
  .profile-text {
    color: var(--color-text-soft);
  }
  .profile-text + .profile-text {
    margin-top: 0.75em;
  }
  .profile-table {
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .profile-table div {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: 1rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }
  .profile-table dt {
    padding-top: 0.2em;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--color-muted);
  }
  /* 長いメールアドレスやURLが、狭い画面で表の外へはみ出さないようにする */
  .profile-table dd {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* ===== できること ===== */
  .service-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 2rem;
  }
  .service-list li {
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .service-list h3 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
  }
  .service-list p {
    font-size: 0.9rem;
    color: var(--color-text-soft);
  }
  .service-list .service-tools {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  @media (max-width: 767px) {
    .service-list {
      grid-template-columns: 1fr;
    }
  }

  /* ===== 制作 ===== */
  .works-empty {
    color: var(--color-text-soft);
  }

  /* ===== 連絡先 ===== */
  .contact-invite {
    max-width: 34em;
    color: var(--color-text-soft);
  }
  /* メールアドレスそのものを一番大きい押し先にする。高さ64pxは Issue #151 で決めた下限 */
  .contact-button {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    min-height: 64px;
    margin-top: 1.75rem;
    padding: 0.5rem clamp(1.25rem, 5vw, 2.25rem);
    border: 1px solid var(--color-text);
    border-radius: 2px;
    font-weight: 500;
    font-size: clamp(1rem, 4vw, 1.25rem);
    letter-spacing: 0.06em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .contact-button:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }
</style>
