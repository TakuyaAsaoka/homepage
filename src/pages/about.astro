---
import { getEntry } from "astro:content";
import Section from "../components/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toParagraphs } from "../paragraphs";

// CMS管理のAbout文言を取得する
const aboutEntry = await getEntry("about", "about");
if (!aboutEntry) {
  throw new Error("About文言（src/content/pages/about.yaml）が見つかりません");
}
const about = aboutEntry.data;
---

<BaseLayout title="About" description="アサオカの自己紹介 — 経歴・仕事観・人となり" breadcrumb={[{ label: "About" }]}>
  <Section level={1} title="自己紹介" label="ABOUT">
    <p class="about-lead" data-reveal="delayed">{about.lead}</p>
  </Section>

  {/* 文章の章は横に2つずつ並べ、1行が長くなりすぎないようにする */}
  <div class="about-sections cols-2">
    {about.sections.map((section) => (
      <Section title={section.title} label={section.label}>
        <div class="about-body" data-reveal="delayed">
          {toParagraphs(section.body).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </Section>
    ))}
  </div>
</BaseLayout>

<style>
  .about-lead {
    color: var(--color-text-soft);
  }
  /* 縦の間隔は章（Section）が持つので、行の間は空けない */
  .about-sections {
    row-gap: 0;
  }
  .about-body p + p {
    margin-top: 0.75em;
  }
</style>
