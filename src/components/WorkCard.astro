---
import { Image } from "astro:assets";
import TagList from "./TagList.astro";
import { BASE_PATH, DEFAULT_IMAGE, SITE_LOCALE } from "../consts";
import { formatPubDate } from "../date";

interface Props {
  title: string;
  description: string;
  tags: string[];
  slug: string;
  pubDate: string;
  image?: ImageMetadata;
}

const { title, description, tags, slug, pubDate, image } = Astro.props;
// 画像なしの制作でもカードの見た目を揃えるため、未設定時はデフォルト画像で埋める
const thumbnail = image ?? DEFAULT_IMAGE;
---

<article class="work-card">
  {/* サムネイルは装飾。直下の見出しリンクが同じタイトルを読み上げ、
      デフォルト画像は制作の内容を表さないため alt は空にする */}
  {/* 表示幅は2カラム時390px（コンテンツ幅736px − gap20px の半分 ＋ padding分32px）、
      767px以下の1カラム時はほぼ画面幅。widths は等倍・2倍・3倍の画面をまかなう */}
  <Image
    class="thumbnail"
    src={thumbnail}
    alt=""
    widths={[400, 800, 1200]}
    sizes="(min-width: 768px) 390px, 100vw"
    loading="lazy"
    decoding="async"
  />
  <h3>
    <a href={`${BASE_PATH}works/${slug}/`}>{title}</a>
  </h3>
  <p>{description}</p>
  <div class="card-meta">
    <time datetime={pubDate}>{formatPubDate(pubDate, SITE_LOCALE)}</time>
    <TagList tags={tags} />
  </div>
</article>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    /* サムネイルの角をカードの角丸に合わせて切る */
    overflow: hidden;
  }
  /* 画像の実寸に関わらずカード間で高さを揃え、読み込み前も領域を確保する（表示のガタつき防止）。
     カード枠いっぱいに出すため、padding 分を負のマージンで打ち消す */
  .thumbnail {
    display: block;
    width: calc(100% + 2rem);
    /* グローバルの img { max-width: 100% } が padding を打ち消す分を削るため解除する */
    max-width: none;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: -1rem -1rem 0.75rem;
  }
  .work-card h3 a {
    text-decoration: none;
    color: inherit;
  }
  .work-card h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--season-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  /* カード高さが行内で揃った際、公開日とタグを下端に寄せて空白の浮きを防ぐ。
     タグが多い場合は折り返して日付の下に回り込ませる */
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .card-meta time {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
